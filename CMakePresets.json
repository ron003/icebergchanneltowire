{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Dev Debug",
      "description": "Native debug build into /workspaces/build/icebergchanneltowire with install prefix /workspaces/install.",
      "generator": "Ninja",
      "binaryDir": "/workspaces/build/icebergchanneltowire/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "/workspaces/install",
        "CMAKE_PREFIX_PATH": "/workspaces/install",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Dev Release",
      "description": "Native release build into /workspaces/build/icebergchanneltowire with install prefix /workspaces/install.",
      "generator": "Ninja",
      "binaryDir": "/workspaces/build/icebergchanneltowire/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "/workspaces/install",
        "CMAKE_PREFIX_PATH": "/workspaces/install",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev-aarch64-release",
      "displayName": "Dev AArch64 Release",
      "description": "Cross-compile release build using .devcontainer/cmake-aarch64-toolchain.cmake.",
      "generator": "Ninja",
      "binaryDir": "/workspaces/build/icebergchanneltowire/aarch64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.devcontainer/cmake-aarch64-toolchain.cmake",
        "CMAKE_INSTALL_PREFIX": "/workspaces/install",
        "CMAKE_PREFIX_PATH": "/workspaces/install",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build Debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "build-release",
      "displayName": "Build Release",
      "configurePreset": "dev-release"
    },
    {
      "name": "build-aarch64-release",
      "displayName": "Build AArch64 Release",
      "configurePreset": "dev-aarch64-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "displayName": "Test Debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-release",
      "displayName": "Test Release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-aarch64-release",
      "displayName": "Test AArch64 Release",
      "configurePreset": "dev-aarch64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-debug",
      "displayName": "CI Debug Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "dev-debug"
        },
        {
          "type": "build",
          "name": "build-debug"
        },
        {
          "type": "test",
          "name": "test-debug"
        }
      ]
    },
    {
      "name": "ci-release",
      "displayName": "CI Release Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "dev-release"
        },
        {
          "type": "build",
          "name": "build-release"
        },
        {
          "type": "test",
          "name": "test-release"
        }
      ]
    },
    {
      "name": "ci-aarch64",
      "displayName": "CI AArch64 Workflow",
      "steps": [
        {
          "type": "configure",
          "name": "dev-aarch64-release"
        },
        {
          "type": "build",
          "name": "build-aarch64-release"
        },
        {
          "type": "test",
          "name": "test-aarch64-release"
        }
      ]
    }
  ]
}
